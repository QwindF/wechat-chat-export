__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.spec

# 临时中转文件（导出写盘原子替换产生）
*.tmp

# IDE / 系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地截图目录（可能包含聊天界面截图）
.screenshots/

# 本地工具/智能体工作目录（spec、评审记录等过程产物，不入库）
.trae/
