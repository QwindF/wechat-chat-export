final_export/

# 自定义输出目录（--out / GUI「输出目录」常见命名，前瞻性加固；默认 exports 由上面规则覆盖）
export_*/
*_export/
*_exports/
chat_export*/

# 聊天原文衍生数据（分析/统计/图表产物，含真实昵称与消息内容，绝不能入库）
analysis/
analysis*/
*_analysis/
chatlog*/
chat_logs/
# 分析报告（含真实姓名、群名、互动频次），任意层级均忽略
*聊天记录分析报告*.md
*分析报告*.md

# 运行日志（可能含本机路径与媒体文件名）
*.log
logs/

# 本地虚拟环境
.venv/

# WorkBuddy 本地数据
.workbuddy/

# 微信解密密钥和缓存
**/keys.json
wechatauto_db/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# wechatauto-replica 默认相对路径副产物
